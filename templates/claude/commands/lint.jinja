#!/usr/bin/env bash
# Lint command for {{ project_name }}

echo "🔍 Running linter for {{ project_name }}"

{% if 'lint' in scripts %}
{{ scripts.lint }}
{% elif 'npm' in package_managers %}
npm run lint
{% elif language == 'Python' %}
{% if 'black' in dev_deps %}
black . --check
{% endif %}
{% if 'flake8' in dev_deps %}
flake8 .
{% endif %}
{% if 'mypy' in dev_deps %}
mypy .
{% endif %}
{% else %}
echo "No lint command configured"
exit 1
{% endif %}

if [ $? -eq 0 ]; then
    echo "✅ Linting passed!"
else
    echo "❌ Linting failed"
    exit 1
fi